[worldserver]

########################################
# mod-ollama-bot-buddy configuration
########################################

# OllamaBotControl.Enable
#     Description: Enable or disable the Ollama Bot Control module.
#     Default:     1 (true)
OllamaBotControl.Enable = 1

# OllamaBotControl.Url
#     Description: The URL used to query the Ollama API for bot command generation.
#     Default:     http://localhost:11434/api/generate
OllamaBotControl.Url = http://localhost:11434/api/generate

# OllamaBotControl.Model
#     Description: The model identifier to be used in the Ollama API request.
#     Default:     llama3.2:1b
OllamaBotControl.Model = llama3.2:1b

# OllamaBotControl.Debug
#     Description: Enable or disable verbose debug logs for Ollama Bot Buddy.
#     Default:     0 (false)
#     0 = disabled, 1 = enabled
OllamaBotControl.Debug = 0

# OllamaBotControl.EnableBotBuddyAddon
#     Description: Enable or disable sending the bot state to the Bot Buddy addon for Ollama Bot.
#     Default:     0 (false)
#     0 = disabled, 1 = enabled
OllamaBotControl.EnableBotBuddyAddon = 0

# OllamaBotControl.TestBotCount
#     Drive this many arbitrary online bots regardless of name or grouping.
#     Testing only. BotNames silently controls nothing when the named bot has
#     been rotated out of the world by the level bracket system, which looks
#     identical to the module being broken. Pair with RequirePlayerOnline = 0,
#     and put both back afterwards: leaving RequirePlayerOnline = 0 on pins a
#     multi-GB model in memory and has caused OOM kills.
#     Default: 0 (disabled)
OllamaBotControl.TestBotCount = 0

# OllamaBotControl.TestBotFilter
#     Which bots TestBotCount is allowed to adopt.
#       any     whichever bots come first. In a 500-bot world that means bots
#               idling in towns: only 4% of captured prompts had the bot in
#               combat, so combat decisions were barely sampled.
#       combat  only bots currently in combat. The slot is released when a bot
#               leaves combat, so the sample keeps following live fighting.
#     Default: any
OllamaBotControl.TestBotFilter = any

# OllamaBotControl.ClearNonCombatStrategies
#     Whether takeover deletes the bot's non-combat brain (mod-playerbots' own
#     AI for questing, travel, looting and vendoring). Clearing it stops the
#     native AI fighting the LLM over movement, but it is also why a taken-over
#     bot cannot quest, loot or travel by itself.
#     Default: 1 (clear, existing behaviour). 0 leaves the native AI in place.
OllamaBotControl.ClearNonCombatStrategies = 1

# OllamaBotControl.DeterministicActions
#     Execute the situation assessment directly instead of asking the model to
#     agree with it. Covers corpse underfoot, an attacker on you, a quest giver
#     or turn-in in reach, and a visible quest objective. Ticks with no definite
#     answer still go to the LLM, which is where speech and open-ended choices
#     live.
#     Default: 1 (enabled)
OllamaBotControl.DeterministicActions = 1

# OllamaBotControl.CombatStrafe
#     Step sideways during combat instead of standing still. Preserves the range
#     band the bot fights from, requires line of sight to the target and a
#     pathable destination, and never fires while a cast is in progress (movement
#     would cancel it).
#     Default: 1 (enabled)
OllamaBotControl.CombatStrafe = 1

# OllamaBotControl.SayCooldownSeconds
#     Minimum seconds between two things a bot says out loud, jittered up to
#     double so a crowd does not speak in lockstep. A bot also stays quiet when
#     nobody is within about 30 yards to hear it.
#     Default: 240
OllamaBotControl.SayCooldownSeconds = 240

# OllamaBotControl.DuelCooldownSeconds
#     Minimum seconds between one bot challenging another to a duel, jittered up
#     to double. Only fires when both are idle, out of combat, same faction and
#     within 8 yards. The core refuses duels inside sanctuaries, so in practice
#     this happens outside city gates. 0 disables.
#     Default: 3600
OllamaBotControl.DuelCooldownSeconds = 3600

# --------------------------------------------
# GAMEPLAY TELEMETRY
# --------------------------------------------
#
# A durable, correlated record of what bots decided and whether it worked, so a
# situation can be revisited afterwards instead of reconstructed from prose in
# Server.log. Written as JSONL, one file per server run, never truncated. Read
# it with tools/telemetry.py.
#
# Every event from one decision shares a "turn" id, so a prompt, the reply it
# produced, the command that came out and the outcome line up:
#
#   ./telemetry.py stuck      -- bots that retried the same failing thing
#   ./telemetry.py failures   -- what did not work, most repeated first
#   ./telemetry.py turn 8142  -- one decision start to finish
#
# The writer runs on its own thread and drops events rather than stalling the
# world thread if it ever falls behind.

# OllamaBotControl.Telemetry
#     Description: Record gameplay telemetry. Set to 0 to disable entirely.
#     Default:     1 (true)
OllamaBotControl.Telemetry = 1

# OllamaBotControl.TelemetryAllBots
#     Description: Record every bot on the realm rather than only those in your
#                  party or near you. Turns a session's file from megabytes into
#                  gigabytes; useful only for whole-realm analysis.
#     Default:     0 (false)
OllamaBotControl.TelemetryAllBots = 0

# OllamaBotControl.TelemetryPlayerRadius
#     Description: How close a bot must be to a real player to be recorded when
#                  TelemetryAllBots is off. Party members are always recorded
#                  regardless of distance.
#     Default:     120
OllamaBotControl.TelemetryPlayerRadius = 120

# OllamaBotControl.TelemetryFullPrompts
#     Description: Store the entire prompt with every decision. It is ~25KB and
#                  mostly the same static text each time; the situation lines,
#                  which are recorded either way, are the part that varies.
#                  Turn this on when investigating prompt wording specifically.
#     Default:     0 (false)
OllamaBotControl.TelemetryFullPrompts = 0

# OllamaBotControl.TelemetryDir
#     Description: Where the files go. This is a path inside the container.
#     Default:     /azerothcore/env/dist/logs/telemetry
OllamaBotControl.TelemetryDir = "/azerothcore/env/dist/logs/telemetry"
